# LedgerPilot environment
# mock (default) = full loop, zero credentials. sandbox = real PayPal sandbox REST.
PAYPAL_MODE=mock

# Only required when PAYPAL_MODE=sandbox (from your own PayPal Developer app):
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# Optional ledger persistence. Unset = in-memory (plans/audit reset on restart).
# Set to a JSON file path to persist plans, the audit log, and webhook
# idempotency across restarts (single server process per file):
# LEDGERPILOT_STORE_FILE=./ledgerpilot.ledger.json

# Optional LLM adapter (any OpenAI-compatible endpoint). Unset = deterministic agent.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
